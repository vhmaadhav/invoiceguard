<?xml version="1.0" encoding="UTF-8"?>
<Module version="122100000" xmlns="http://xmlns.oracle.com/Forms">
  <FormModule Name="IG_EXCEPTIONS" Title="InvoiceGuard - Exception Workbench" ConsoleWindow="W_EXC">
    <Coordinate CoordinateSystem="Real" RealUnit="Pixel" />
    <AttachedLibrary Name="IG_LIB" LibraryLocation="IG_LIB.pll" />
    <Window Name="W_EXC" Title="InvoiceGuard - Exception Workbench" Width="1162" Height="422" PrimaryCanvas="CV_EXC" />
    <Canvas Name="CV_EXC" CanvasType="Content" WindowName="W_EXC" Width="1162" Height="422" ViewportXPosition="0" ViewportYPosition="0" ViewportWidth="1162" ViewportHeight="422" ShowHorizontalScrollbar="false" ShowVerticalScrollbar="false" />
    <Alert Name="IG_ERROR_ALERT" Title="InvoiceGuard" AlertStyle="Stop" AlertMessage="InvoiceGuard could not complete the action. See the message line." Button1Label="OK" DefaultAlertButton="Button 1" />
    <Alert Name="IG_CONFIRM_ALERT" Title="InvoiceGuard" AlertStyle="Caution" AlertMessage="Are you sure you want to continue?" Button1Label="OK" Button2Label="Cancel" DefaultAlertButton="Button 1" />
    <VisualAttribute Name="VA_HIGH" BackColor="r100g0b0" ForegroundColor="white" />
    <VisualAttribute Name="VA_MEDIUM" BackColor="yellow" ForegroundColor="black" />
    <VisualAttribute Name="VA_LOW" BackColor="white" ForegroundColor="black" />
    <Trigger Name="PRE-FORM" TriggerText="BEGIN&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.IG_USER');&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.IG_ROLE');&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.F_CAT');&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.F_SEV');&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.F_HCODE');&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.F_VEND');&#10;  DEFAULT_VALUE(NULL, 'GLOBAL.F_AGE');&#10;  ig_nav.init_globals;&#10;EXCEPTION&#10;  WHEN OTHERS THEN&#10;    ig_msg.show_error(SQLERRM);&#10;END;" />
    <Trigger Name="ON-ERROR" TriggerText="BEGIN&#10;  ig_msg.show_error;&#10;END;" />
    <Trigger Name="KEY-EXIT" TriggerText="BEGIN&#10;  EXIT_FORM(NO_VALIDATE);&#10;EXCEPTION&#10;  WHEN OTHERS THEN&#10;    ig_msg.show_error(SQLERRM);&#10;END;" />
    <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="BEGIN&#10;  ig_nav.restore_session(TRUE);&#10;  ig_ui.refresh_queue;&#10;EXCEPTION&#10;  WHEN OTHERS THEN&#10;    ig_msg.show_error(SQLERRM);&#10;END;" />
    <ProgramUnit Name="reset_filters" ProgramUnitType="Procedure" ProgramUnitText="PROCEDURE reset_filters IS&#10;BEGIN&#10;  :FILTER.CATEGORY := NULL;&#10;  :FILTER.SEVERITY := NULL;&#10;  :FILTER.HOLD_CODE := NULL;&#10;  :FILTER.VENDOR_NUM := NULL;&#10;  :FILTER.MIN_AGE := NULL;&#10;END reset_filters;" />
    <Block Name="FILTER" DatabaseBlock="false">
      <Item Name="CATEGORY" ItemType="Text Item" DataType="Char" MaximumLength="20" DatabaseItem="false" CanvasName="CV_EXC" XPosition="12" YPosition="26" Width="260" Height="22" Prompt="Category" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="true" />
      <Item Name="SEVERITY" ItemType="Text Item" DataType="Char" MaximumLength="10" DatabaseItem="false" CanvasName="CV_EXC" XPosition="290" YPosition="26" Width="180" Height="22" Prompt="Severity" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="true" />
      <Item Name="HOLD_CODE" ItemType="Text Item" DataType="Char" MaximumLength="20" DatabaseItem="false" CanvasName="CV_EXC" XPosition="490" YPosition="26" Width="160" Height="22" Prompt="Hold code" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="true" />
      <Item Name="VENDOR_NUM" ItemType="Text Item" DataType="Char" MaximumLength="30" DatabaseItem="false" CanvasName="CV_EXC" XPosition="12" YPosition="64" Width="200" Height="22" Prompt="Vendor number" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="true" />
      <Item Name="MIN_AGE" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="false" CanvasName="CV_EXC" XPosition="230" YPosition="64" Width="160" Height="22" Prompt="Minimum age (days)" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="true" />
    </Block>
    <Block Name="CTRL" DatabaseBlock="false">
      <Item Name="BTN_APPLY" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_EXC" XPosition="12" YPosition="90" Width="120" Height="22" Label="Apply filter" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  ig_ui.refresh_queue;&#10;EXCEPTION&#10;  WHEN OTHERS THEN&#10;    ig_msg.show_error(SQLERRM);&#10;END;" />
      </Item>
      <Item Name="BTN_RESET" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_EXC" XPosition="140" YPosition="90" Width="90" Height="22" Label="Reset" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  BEGIN&#10;    reset_filters;&#10;  EXCEPTION&#10;    WHEN OTHERS THEN&#10;      ig_msg.show_error(SQLERRM);&#10;  END;&#10;  ig_ui.refresh_queue;&#10;END;" />
      </Item>
      <Item Name="BTN_RELEASE" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_EXC" XPosition="240" YPosition="90" Width="120" Height="22" Label="Release hold" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  DECLARE&#10;    l_hold NUMBER := TO_NUMBER(NAME_IN('QUEUE.HOLD_ID'));&#10;  BEGIN&#10;    IF l_hold IS NULL THEN&#10;      ig_msg.info('Select an exception row first.');&#10;      RETURN;&#10;    END IF;&#10;    ig_workflow_pkg.release_hold(l_hold, ig_ui.ask_reason('CTRL.REASON'));&#10;  EXCEPTION&#10;    WHEN OTHERS THEN&#10;      ig_msg.show_error(SQLERRM);&#10;  END;&#10;  ig_ui.refresh_queue;&#10;END;" />
      </Item>
      <Item Name="BTN_OPEN" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_EXC" XPosition="370" YPosition="90" Width="120" Height="22" Label="Open invoice" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="DECLARE&#10;  l_inv NUMBER := TO_NUMBER(NAME_IN('QUEUE.INVOICE_ID'));&#10;BEGIN&#10;  IF l_inv IS NULL THEN&#10;    ig_msg.info('Select an exception row first.');&#10;    RETURN;&#10;  END IF;&#10;  ig_nav.open_invoice(l_inv);&#10;EXCEPTION&#10;  WHEN OTHERS THEN&#10;    ig_msg.show_error(SQLERRM);&#10;END;" />
      </Item>
      <Item Name="BTN_SCAN" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_EXC" XPosition="500" YPosition="90" Width="140" Height="22" Label="Run approval scan" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  DECLARE&#10;    l_new NUMBER;&#10;  BEGIN&#10;    l_new := ig_audit_pkg.scan_approvals;&#10;    ig_msg.info('Approval scan placed ' || l_new || ' new UNAUTH_APPROVAL hold(s).');&#10;  EXCEPTION&#10;    WHEN OTHERS THEN&#10;      ig_msg.show_error(SQLERRM);&#10;  END;&#10;  ig_ui.refresh_queue;&#10;END;" />
      </Item>
      <Item Name="BTN_VALIDATE_ALL" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_EXC" XPosition="650" YPosition="90" Width="150" Height="22" Label="Validate all drafts" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  BEGIN&#10;    ig_match_pkg.validate_all_draft;&#10;    ig_msg.info('Validation of all DRAFT and ON_HOLD invoices finished.');&#10;  EXCEPTION&#10;    WHEN OTHERS THEN&#10;      ig_msg.show_error(SQLERRM);&#10;  END;&#10;  ig_ui.refresh_queue;&#10;END;" />
      </Item>
      <Item Name="REASON" ItemType="Text Item" DataType="Char" MaximumLength="400" DatabaseItem="false" CanvasName="CV_EXC" XPosition="12" YPosition="130" Width="520" Height="22" Prompt="Release reason (mandatory)" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="true" />
    </Block>
    <Block Name="QUEUE" DatabaseBlock="true" QueryDataSourceName="IG_EXCEPTION_QUEUE_V" QueryDataSourceType="Table" RecordOrientation="Vertical" RecordsDisplayCount="5" QueryAllowed="true" InsertAllowed="false" UpdateAllowed="false" DeleteAllowed="false">
      <Item Name="HOLD_ID" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="true" ColumnName="hold_id" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="70" Height="22" Prompt="Hold id" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="INVOICE_ID" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="true" ColumnName="invoice_id" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="80" Height="22" Prompt="Invoice id" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="INVOICE_NUM" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="invoice_num" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="110" Height="22" Prompt="Invoice num" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="VENDOR_NUM" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="vendor_num" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="90" Height="22" Prompt="Vendor num" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="VENDOR_NAME" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="vendor_name" CanvasName="CV_EXC" XPosition="138" YPosition="170" Width="150" Height="22" Prompt="Vendor name" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="PO_NUM" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="po_num" CanvasName="CV_EXC" XPosition="304" YPosition="170" Width="90" Height="22" Prompt="Po num" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="BASE_AMOUNT" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="true" ColumnName="base_amount" CanvasName="CV_EXC" XPosition="410" YPosition="170" Width="110" Height="22" Prompt="Base amount" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="HOLD_CODE" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="hold_code" CanvasName="CV_EXC" XPosition="536" YPosition="170" Width="110" Height="22" Prompt="Hold code" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="CATEGORY" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="category" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="110" Height="22" Prompt="Category" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="SEVERITY" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="severity" CanvasName="CV_EXC" XPosition="662" YPosition="170" Width="70" Height="22" Prompt="Severity" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="HOLD_REASON" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="hold_reason" CanvasName="CV_EXC" XPosition="748" YPosition="170" Width="200" Height="22" Prompt="Hold reason" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="LINE_NUM" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="true" ColumnName="line_num" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="60" Height="22" Prompt="Line num" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="HOLD_DATE" ItemType="Text Item" DataType="Date" MaximumLength="100" DatabaseItem="true" ColumnName="hold_date" CanvasName="CV_EXC" XPosition="964" YPosition="170" Width="110" Height="22" Prompt="Hold date" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="AGE_DAYS" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="true" ColumnName="age_days" CanvasName="CV_EXC" XPosition="1090" YPosition="170" Width="60" Height="22" Prompt="Age days" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" />
      <Item Name="RISK_SCORE" ItemType="Text Item" DataType="Number" MaximumLength="100" DatabaseItem="true" ColumnName="risk_score" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="80" Height="22" Prompt="Risk score" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="RELEASE_ROLE" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="release_role" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="100" Height="22" Prompt="Release role" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
      <Item Name="ENTERED_BY" ItemType="Text Item" DataType="Char" MaximumLength="100" DatabaseItem="true" ColumnName="entered_by" CanvasName="CV_EXC" XPosition="12" YPosition="170" Width="100" Height="22" Prompt="Entered by" PromptAttachmentEdge="Top" PromptAlign="Start" Enabled="true" UpdateAllowed="false" Visible="false" />
    </Block>
  </FormModule>
</Module>
