-- IG_MAIN triggers. Generated by forms/tools/gen_forms_xml.py. Do not edit by hand.
-- Same text as the TriggerText of the owning element in IG_MAIN_fmb.xml.

-- ===== IG_MAIN | form | PRE-FORM =====
BEGIN
  DEFAULT_VALUE(NULL, 'GLOBAL.IG_USER');
  DEFAULT_VALUE(NULL, 'GLOBAL.IG_ROLE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_CAT');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_SEV');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_HCODE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_VEND');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_AGE');
  ig_nav.init_globals;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_MAIN | form | ON-ERROR =====
BEGIN
  ig_msg.show_error;
END;

-- ===== IG_MAIN | form | KEY-EXIT =====
BEGIN
  EXIT_FORM(NO_VALIDATE);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_MAIN | form | WHEN-NEW-FORM-INSTANCE =====
BEGIN
  Go_Block('CTRL');
  ig_nav.restore_session(FALSE);
  IF ig_msg.global_value('GLOBAL.IG_USER') IS NOT NULL THEN
    ig_nav.refresh_dashboard;
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_MAIN | form | KEY-COMMIT =====
BEGIN
  ig_nav.save;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_MAIN | item CTRL.BTN_LOGIN | WHEN-BUTTON-PRESSED =====
BEGIN
  ig_session_pkg.set_user(UPPER(TRIM(:CTRL.USER_NAME)));
  COPY(ig_session_pkg.current_user, 'GLOBAL.IG_USER');
  COPY(ig_session_pkg.current_role, 'GLOBAL.IG_ROLE');
  :CTRL.LOGIN_STATUS := 'Logged in as ' || ig_msg.global_value('GLOBAL.IG_USER') || ' (' || ig_msg.global_value('GLOBAL.IG_ROLE') || ')';
  ig_nav.refresh_dashboard;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_MAIN | item CTRL.BTN_REFRESH | WHEN-BUTTON-PRESSED =====
BEGIN
  ig_nav.refresh_dashboard;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

