-- IG_SETUP triggers. Generated by forms/tools/gen_forms_xml.py. Do not edit by hand.
-- Same text as the TriggerText of the owning element in IG_SETUP_fmb.xml.

-- ===== IG_SETUP | form | PRE-FORM =====
BEGIN
  DEFAULT_VALUE(NULL, 'GLOBAL.IG_USER');
  DEFAULT_VALUE(NULL, 'GLOBAL.IG_ROLE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_CAT');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_SEV');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_HCODE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_VEND');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_AGE');
  ig_nav.init_globals;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_SETUP | form | ON-ERROR =====
BEGIN
  ig_msg.show_error;
END;

-- ===== IG_SETUP | form | KEY-EXIT =====
BEGIN
  EXIT_FORM(NO_VALIDATE);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_SETUP | form | WHEN-NEW-FORM-INSTANCE =====
BEGIN
  ig_nav.restore_session(TRUE);
  set_setup_access;
  load_setup_lists;
  Go_Block('VENDORS');
  Set_Block_Property('VENDORS', ORDER_BY, 'VENDOR_NAME');
  -- master only: ON-POPULATE-DETAILS fills the bank accounts of the current vendor
  Execute_Query;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_SETUP | form | KEY-COMMIT =====
BEGIN
  ig_nav.save;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_SETUP | block VENDORS | ON-POPULATE-DETAILS =====
DECLARE
  recstat  VARCHAR2(20) := :System.Record_Status;
  startitm VARCHAR2(61) := :System.Cursor_Item;
  rel_id   Relation;
BEGIN
  IF ( recstat = 'NEW' OR recstat = 'INSERT' ) THEN
    RETURN;
  END IF;

  IF ( :VENDORS.VENDOR_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('BANKS', DEFAULT_WHERE, 'VENDOR_ID = ' || TO_CHAR(:VENDORS.VENDOR_ID));
    rel_id := Find_Relation('VENDORS.VENDORS_BANKS');
    Query_Master_Details(rel_id, 'BANKS');
  END IF;

  IF ( :System.Cursor_Item <> startitm ) THEN
    Go_Item(startitm);
    Check_Package_Failure;
  END IF;
END;


-- ===== IG_SETUP | block VENDORS | ON-CLEAR-DETAILS =====
BEGIN
  Clear_All_Master_Details;
END;


-- ===== IG_SETUP | item VENDORS.GSTIN | WHEN-VALIDATE-ITEM =====
BEGIN
  IF :VENDORS.gstin IS NOT NULL AND ig_util_pkg.valid_gstin(:VENDORS.gstin) = 'N' THEN
    ig_msg.info('GSTIN fails the format or check-digit test. A GSTIN_INVALID hold is raised on validate.');
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_SETUP | block BANKS | PRE-INSERT =====
BEGIN
  :BANKS.created_by := ig_msg.global_value('GLOBAL.IG_USER');
  :BANKS.effective_from := NVL(:BANKS.effective_from, SYSDATE);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;
