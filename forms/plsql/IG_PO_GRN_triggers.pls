-- ===== IG_PO_GRN | block PO_HDR | ON-POPULATE-DETAILS =====
DECLARE
  recstat  VARCHAR2(20) := :System.Record_Status;
  startitm VARCHAR2(61) := :System.Cursor_Item;
  rel_id   Relation;
BEGIN
  IF ( recstat = 'NEW' OR recstat = 'INSERT' ) THEN
    RETURN;
  END IF;

  IF ( :PO_HDR.PO_HEADER_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('PO_LINES', DEFAULT_WHERE, 'PO_HEADER_ID = ' || TO_CHAR(:PO_HDR.PO_HEADER_ID));
    rel_id := Find_Relation('PO_HDR.PO_HDR_PO_LINES');
    Query_Master_Details(rel_id, 'PO_LINES');
  END IF;

  IF ( :PO_HDR.PO_HEADER_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('RECEIPTS', DEFAULT_WHERE, 'PO_HEADER_ID = ' || TO_CHAR(:PO_HDR.PO_HEADER_ID));
    rel_id := Find_Relation('PO_HDR.PO_HDR_RECEIPTS');
    Query_Master_Details(rel_id, 'RECEIPTS');
  END IF;

  IF ( :System.Cursor_Item <> startitm ) THEN
    Go_Item(startitm);
    Check_Package_Failure;
  END IF;
END;


