-- IG_SETUP program units. Generated by forms/tools/gen_forms_xml.py.

-- ===== IG_SETUP | program unit CHECK_PACKAGE_FAILURE =====
PROCEDURE Check_Package_Failure IS
BEGIN
  IF NOT ( Form_Success ) THEN
    RAISE Form_Trigger_Failure;
  END IF;
END;


-- ===== IG_SETUP | program unit QUERY_MASTER_DETAILS =====
PROCEDURE Query_Master_Details(rel_id Relation, detail VARCHAR2) IS
  oldmsg VARCHAR2(2);
  reldef VARCHAR2(5);
BEGIN
  reldef := Get_Relation_Property(rel_id, DEFERRED_COORDINATION);
  oldmsg := :System.Message_Level;
  IF reldef = 'FALSE' THEN
    Go_Block(detail);
    Check_Package_Failure;
    :System.Message_Level := '10';
    Execute_Query;
    :System.Message_Level := oldmsg;
  ELSE
    Set_Block_Property(detail, COORDINATION_STATUS, NON_COORDINATED);
  END IF;
EXCEPTION
  WHEN Form_Trigger_Failure THEN
    :System.Message_Level := oldmsg;
    RAISE;
END Query_Master_Details;


-- ===== IG_SETUP | program unit CLEAR_ALL_MASTER_DETAILS =====
PROCEDURE Clear_All_Master_Details IS
  mastblk  VARCHAR2(30);
  coordop  VARCHAR2(30);
  trigblk  VARCHAR2(30);
  startitm VARCHAR2(61);
  frmstat  VARCHAR2(15);
  curblk   VARCHAR2(30);
  currel   VARCHAR2(30);
  curdtl   VARCHAR2(30);

  FUNCTION First_Changed_Block_Below(Master VARCHAR2) RETURN VARCHAR2 IS
    curblk VARCHAR2(30);
    currel VARCHAR2(30);
    retblk VARCHAR2(30);
  BEGIN
    curblk := Master;
    currel := Get_Block_Property(curblk, FIRST_MASTER_RELATION);
    WHILE currel IS NOT NULL LOOP
      curblk := Get_Relation_Property(currel, DETAIL_NAME);
      IF ( Get_Block_Property(curblk, STATUS) = 'CHANGED' ) THEN
        RETURN curblk;
      ELSE
        retblk := First_Changed_Block_Below(curblk);
        IF retblk IS NOT NULL THEN
          RETURN retblk;
        ELSE
          currel := Get_Relation_Property(currel, NEXT_MASTER_RELATION);
        END IF;
      END IF;
    END LOOP;
    RETURN NULL;
  END First_Changed_Block_Below;

BEGIN
  mastblk  := :System.Master_Block;
  coordop  := :System.Coordination_Operation;
  trigblk  := :System.Trigger_Block;
  startitm := :System.Cursor_Item;
  frmstat  := :System.Form_Status;

  IF coordop NOT IN ('CLEAR_RECORD', 'SYNCHRONIZE_BLOCKS') THEN
    IF mastblk = trigblk THEN
      IF frmstat = 'CHANGED' THEN
        curblk := First_Changed_Block_Below(mastblk);
        IF curblk IS NOT NULL THEN
          Go_Block(curblk);
          Check_Package_Failure;
          Clear_Block(ASK_COMMIT);
          IF NOT ( :System.Form_Status = 'QUERY'
                   OR :System.Block_Status = 'NEW' ) THEN
            RAISE Form_Trigger_Failure;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  currel := Get_Block_Property(trigblk, FIRST_MASTER_RELATION);
  WHILE currel IS NOT NULL LOOP
    curdtl := Get_Relation_Property(currel, DETAIL_NAME);
    IF Get_Block_Property(curdtl, STATUS) <> 'NEW' THEN
      Go_Block(curdtl);
      Check_Package_Failure;
      Clear_Block(NO_VALIDATE);
      IF :System.Block_Status <> 'NEW' THEN
        RAISE Form_Trigger_Failure;
      END IF;
    END IF;
    currel := Get_Relation_Property(currel, NEXT_MASTER_RELATION);
  END LOOP;

  IF :System.Cursor_Item <> startitm THEN
    Go_Item(startitm);
    Check_Package_Failure;
  END IF;
EXCEPTION
  WHEN Form_Trigger_Failure THEN
    IF :System.Cursor_Item <> startitm THEN
      Go_Item(startitm);
    END IF;
    RAISE;
END Clear_All_Master_Details;


-- ===== IG_SETUP | program unit set_block_edit =====
PROCEDURE set_block_edit(p_block VARCHAR2, p_on BOOLEAN) IS
BEGIN
  IF p_on THEN
    Set_Block_Property(p_block, INSERT_ALLOWED, PROPERTY_TRUE);
    Set_Block_Property(p_block, UPDATE_ALLOWED, PROPERTY_TRUE);
    Set_Block_Property(p_block, DELETE_ALLOWED, PROPERTY_TRUE);
  ELSE
    Set_Block_Property(p_block, INSERT_ALLOWED, PROPERTY_FALSE);
    Set_Block_Property(p_block, UPDATE_ALLOWED, PROPERTY_FALSE);
    Set_Block_Property(p_block, DELETE_ALLOWED, PROPERTY_FALSE);
  END IF;
END set_block_edit;

-- ===== IG_SETUP | program unit load_setup_lists =====
PROCEDURE load_setup_lists IS
BEGIN
  -- independent blocks (not details of VENDORS): each is queried once on open
  Go_Block('USERS');
  Set_Block_Property('USERS', ORDER_BY, 'USER_NAME');
  Execute_Query;
  Go_Block('SETTINGS');
  Set_Block_Property('SETTINGS', ORDER_BY, 'PARAM_NAME');
  Execute_Query;
  Go_Block('HOLD_CODES');
  Set_Block_Property('HOLD_CODES', ORDER_BY, 'HOLD_CODE');
  Execute_Query;
END load_setup_lists;

-- ===== IG_SETUP | program unit set_setup_access =====
PROCEDURE set_setup_access IS
  l_fin BOOLEAN := NVL(ig_msg.global_value('GLOBAL.IG_ROLE'), ' ') = 'FIN_CONTROLLER';
BEGIN
  -- Only FIN_CONTROLLER maintains master data; HOLD_CODES is always read-only.
  set_block_edit('VENDORS', l_fin);
  set_block_edit('BANKS', l_fin);
  set_block_edit('USERS', l_fin);
  set_block_edit('SETTINGS', l_fin);
END set_setup_access;
