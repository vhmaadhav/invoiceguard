-- IG_INVOICE triggers. Generated by forms/tools/gen_forms_xml.py. Do not edit by hand.
-- Same text as the TriggerText of the owning element in IG_INVOICE_fmb.xml.

-- ===== IG_INVOICE | form | PRE-FORM =====
BEGIN
  DEFAULT_VALUE(NULL, 'GLOBAL.IG_USER');
  DEFAULT_VALUE(NULL, 'GLOBAL.IG_ROLE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_CAT');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_SEV');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_HCODE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_VEND');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_AGE');
  ig_nav.init_globals;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | form | ON-ERROR =====
BEGIN
  ig_msg.show_error;
END;

-- ===== IG_INVOICE | form | KEY-EXIT =====
BEGIN
  EXIT_FORM(NO_VALIDATE);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | form | WHEN-NEW-FORM-INSTANCE =====
BEGIN
  ig_nav.restore_session(TRUE);
  IF :PARAMETER.P_INVOICE_ID IS NOT NULL THEN
    load_invoice(TO_NUMBER(:PARAMETER.P_INVOICE_ID));
  ELSE
    Go_Block('INV_HDR');
    Set_Block_Property('INV_HDR', ORDER_BY, 'INVOICE_DATE DESC, INVOICE_ID DESC');
    -- no query here: a query of all invoices fetched 25 masters and each ON-POPULATE-DETAILS appended
    -- the lines of every invoice to the detail block. The user queries (F11, Ctrl+F11).
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | form | KEY-COMMIT =====
BEGIN
  ig_nav.save;
  ig_ui.apply_invoice_state;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | item CTRL.BTN_VALIDATE | WHEN-BUTTON-PRESSED =====
BEGIN
  DECLARE
    l_n NUMBER;
  BEGIN
    l_n := ig_match_pkg.validate_invoice(:INV_HDR.invoice_id);
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_invoice;
END;

-- ===== IG_INVOICE | item CTRL.BTN_APPROVE | WHEN-BUTTON-PRESSED =====
BEGIN
  BEGIN
    ig_workflow_pkg.approve_invoice(:INV_HDR.invoice_id, NAME_IN('CTRL.REASON'));
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_invoice;
END;

-- ===== IG_INVOICE | item CTRL.BTN_REJECT | WHEN-BUTTON-PRESSED =====
BEGIN
  BEGIN
    ig_workflow_pkg.reject_invoice(:INV_HDR.invoice_id, ig_ui.ask_reason('CTRL.REASON'));
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_invoice;
END;

-- ===== IG_INVOICE | item CTRL.BTN_CANCEL | WHEN-BUTTON-PRESSED =====
BEGIN
  BEGIN
    IF ig_ui.confirm('Cancel this invoice? Open holds are released with reason Invoice cancelled.') THEN
      ig_workflow_pkg.cancel_invoice(:INV_HDR.invoice_id, ig_ui.ask_reason('CTRL.REASON'));
    END IF;
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_invoice;
END;

-- ===== IG_INVOICE | item CTRL.BTN_RELEASE | WHEN-BUTTON-PRESSED =====
BEGIN
  DECLARE
    l_hold NUMBER := TO_NUMBER(NAME_IN('HOLDS.HOLD_ID'));
  BEGIN
    IF l_hold IS NULL THEN
      ig_msg.info('Select an open hold in the Holds tab first.');
      RETURN;
    END IF;
    ig_workflow_pkg.release_hold(l_hold, ig_ui.ask_reason('CTRL.REASON'));
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_invoice;
END;

-- ===== IG_INVOICE | item CTRL.BTN_PAID | WHEN-BUTTON-PRESSED =====
BEGIN
  BEGIN
    ig_workflow_pkg.mark_paid(:INV_HDR.invoice_id, NAME_IN('CTRL.PAYMENT_REF'));
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_invoice;
END;

-- ===== IG_INVOICE | item CTRL.BTN_AUDIT | WHEN-BUTTON-PRESSED =====
BEGIN
  ig_nav.show_history;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block INV_HDR | PRE-INSERT =====
BEGIN
  :INV_HDR.created_by := ig_msg.global_value('GLOBAL.IG_USER');
  :INV_HDR.entered_by := ig_msg.global_value('GLOBAL.IG_USER');
  :INV_HDR.received_date := NVL(:INV_HDR.received_date, SYSDATE);
  :INV_HDR.currency := NVL(:INV_HDR.currency, 'INR');
  :INV_HDR.exchange_rate := NVL(:INV_HDR.exchange_rate, 1);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block INV_HDR | WHEN-NEW-RECORD-INSTANCE =====
BEGIN
  ig_ui.apply_invoice_state;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block INV_HDR | POST-QUERY =====
BEGIN
  SELECT vendor_name INTO :INV_HDR.vendor_name FROM IG_VENDORS
   WHERE vendor_id = :INV_HDR.vendor_id;
  IF :INV_HDR.po_header_id IS NOT NULL THEN
    SELECT po_num INTO :INV_HDR.po_num FROM IG_PO_HEADERS
     WHERE po_header_id = :INV_HDR.po_header_id;
  END IF;
  ig_ui.set_risk_va('INV_HDR.RISK_SCORE', :INV_HDR.risk_score);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block INV_HDR | ON-POPULATE-DETAILS =====
DECLARE
  recstat  VARCHAR2(20) := :System.Record_Status;
  startitm VARCHAR2(61) := :System.Cursor_Item;
  rel_id   Relation;
BEGIN
  IF ( recstat = 'NEW' OR recstat = 'INSERT' ) THEN
    RETURN;
  END IF;

  IF ( :INV_HDR.INVOICE_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('INV_LINES', DEFAULT_WHERE, 'INVOICE_ID = ' || TO_CHAR(:INV_HDR.INVOICE_ID));
    rel_id := Find_Relation('INV_HDR.INV_HDR_INV_LINES');
    Query_Master_Details(rel_id, 'INV_LINES');
  END IF;

  IF ( :INV_HDR.INVOICE_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('MATCH', DEFAULT_WHERE, 'INVOICE_ID = ' || TO_CHAR(:INV_HDR.INVOICE_ID));
    rel_id := Find_Relation('INV_HDR.INV_HDR_MATCH');
    Query_Master_Details(rel_id, 'MATCH');
  END IF;

  IF ( :INV_HDR.INVOICE_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('HOLDS', DEFAULT_WHERE, 'INVOICE_ID = ' || TO_CHAR(:INV_HDR.INVOICE_ID));
    rel_id := Find_Relation('INV_HDR.INV_HDR_HOLDS');
    Query_Master_Details(rel_id, 'HOLDS');
  END IF;

  IF ( :INV_HDR.INVOICE_ID IS NOT NULL ) THEN
    -- the relation criteria did not reach Execute_Query (every detail returned the first table rows),
    -- so the join is also written as the detail's DEFAULT_WHERE (same pattern as load_invoice)
    Set_Block_Property('APPR', DEFAULT_WHERE, 'INVOICE_ID = ' || TO_CHAR(:INV_HDR.INVOICE_ID));
    rel_id := Find_Relation('INV_HDR.INV_HDR_APPR');
    Query_Master_Details(rel_id, 'APPR');
  END IF;

  IF ( :System.Cursor_Item <> startitm ) THEN
    Go_Item(startitm);
    Check_Package_Failure;
  END IF;
END;


-- ===== IG_INVOICE | block INV_HDR | ON-CLEAR-DETAILS =====
BEGIN
  Clear_All_Master_Details;
END;


-- ===== IG_INVOICE | block INV_LINES | PRE-INSERT =====
BEGIN
  :INV_LINES.created_by := ig_msg.global_value('GLOBAL.IG_USER');
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block MATCH | WHEN-NEW-RECORD-INSTANCE =====
BEGIN
  IF :MATCH.MATCH_STATUS = 'EXCEPTION' THEN
    ig_ui.set_severity_va('MATCH', 'MEDIUM', 'MATCH_STATUS,PRICE_VAR_PCT');
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block HOLDS | POST-QUERY =====
BEGIN
  SELECT description, severity INTO :HOLDS.HOLD_DESC, :HOLDS.SEVERITY
    FROM IG_HOLD_CODES
   WHERE hold_code = :HOLDS.HOLD_CODE;
  NULL;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_INVOICE | block HOLDS | WHEN-NEW-RECORD-INSTANCE =====
BEGIN
  IF :HOLDS.SEVERITY IS NOT NULL THEN
    ig_ui.set_severity_va('HOLDS', :HOLDS.SEVERITY);
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;
