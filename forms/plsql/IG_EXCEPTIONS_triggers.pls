  DEFAULT_VALUE(NULL, 'GLOBAL.F_CAT');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_SEV');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_HCODE');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_VEND');
  DEFAULT_VALUE(NULL, 'GLOBAL.F_AGE');
  ig_nav.init_globals;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_EXCEPTIONS | form | ON-ERROR =====
BEGIN
  ig_msg.show_error;
END;

-- ===== IG_EXCEPTIONS | form | KEY-EXIT =====
BEGIN
  EXIT_FORM(NO_VALIDATE);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_EXCEPTIONS | form | WHEN-NEW-FORM-INSTANCE =====
BEGIN
  ig_nav.restore_session(TRUE);
  ig_ui.refresh_queue;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_EXCEPTIONS | item CTRL.BTN_APPLY | WHEN-BUTTON-PRESSED =====
BEGIN
  ig_ui.refresh_queue;
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_EXCEPTIONS | item CTRL.BTN_RESET | WHEN-BUTTON-PRESSED =====
BEGIN
  BEGIN
    reset_filters;
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_queue;
END;

-- ===== IG_EXCEPTIONS | item CTRL.BTN_RELEASE | WHEN-BUTTON-PRESSED =====
BEGIN
  DECLARE
    l_hold NUMBER := TO_NUMBER(NAME_IN('QUEUE.HOLD_ID'));
  BEGIN
    IF l_hold IS NULL THEN
      ig_msg.info('Select an exception row first.');
      RETURN;
    END IF;
    ig_workflow_pkg.release_hold(l_hold, ig_ui.ask_reason('CTRL.REASON'));
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_queue;
END;

-- ===== IG_EXCEPTIONS | item CTRL.BTN_OPEN | WHEN-BUTTON-PRESSED =====
DECLARE
  l_inv NUMBER := TO_NUMBER(NAME_IN('QUEUE.INVOICE_ID'));
BEGIN
  IF l_inv IS NULL THEN
    ig_msg.info('Select an exception row first.');
    RETURN;
  END IF;
  ig_nav.open_invoice(l_inv);
EXCEPTION
  WHEN OTHERS THEN
    ig_msg.show_error(SQLERRM);
END;

-- ===== IG_EXCEPTIONS | item CTRL.BTN_SCAN | WHEN-BUTTON-PRESSED =====
BEGIN
  DECLARE
    l_new NUMBER;
  BEGIN
    l_new := ig_audit_pkg.scan_approvals;
    ig_msg.info('Approval scan placed ' || l_new || ' new UNAUTH_APPROVAL hold(s).');
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_queue;
END;

-- ===== IG_EXCEPTIONS | item CTRL.BTN_VALIDATE_ALL | WHEN-BUTTON-PRESSED =====
BEGIN
  BEGIN
    ig_match_pkg.validate_all_draft;
    ig_msg.info('Validation of all DRAFT and ON_HOLD invoices finished.');
  EXCEPTION
    WHEN OTHERS THEN
      ig_msg.show_error(SQLERRM);
  END;
  ig_ui.refresh_queue;
END;
