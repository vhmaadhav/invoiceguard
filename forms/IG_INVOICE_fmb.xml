      </Item>
      <Item Name="BTN_AUDIT" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_INV" XPosition="740" YPosition="12" Width="110" Height="22" Label="Audit trail" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  ig_nav.show_history;&#10;EXCEPTION&#10;  WHEN OTHERS THEN&#10;    ig_msg.show_error(SQLERRM);&#10;END;" />
      </Item>
