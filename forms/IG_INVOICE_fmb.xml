      <Item Name="BTN_CANCEL" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_INV" XPosition="366" YPosition="12" Width="120" Height="22" Label="Cancel invoice" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  BEGIN&#10;    IF ig_ui.confirm('Cancel this invoice? Open holds are released with reason Invoice cancelled.') THEN&#10;      ig_workflow_pkg.cancel_invoice(:INV_HDR.invoice_id, ig_ui.ask_reason('CTRL.REASON'));&#10;    END IF;&#10;  EXCEPTION&#10;    WHEN OTHERS THEN&#10;      ig_msg.show_error(SQLERRM);&#10;  END;&#10;  ig_ui.refresh_invoice;&#10;END;" />
      </Item>
      <Item Name="BTN_RELEASE" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_INV" XPosition="494" YPosition="12" Width="120" Height="22" Label="Release hold" Enabled="true">
        <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="BEGIN&#10;  DECLARE&#10;    l_hold NUMBER := TO_NUMBER(NAME_IN('HOLDS.HOLD_ID'));&#10;  BEGIN&#10;    IF l_hold IS NULL THEN&#10;      ig_msg.info('Select an open hold in the Holds tab first.');&#10;      RETURN;&#10;    END IF;&#10;    ig_workflow_pkg.release_hold(l_hold, ig_ui.ask_reason('CTRL.REASON'));&#10;  EXCEPTION&#10;    WHEN OTHERS THEN&#10;      ig_msg.show_error(SQLERRM);&#10;  END;&#10;  ig_ui.refresh_invoice;&#10;END;" />
      </Item>
      <Item Name="BTN_PAID" ItemType="Push Button" DatabaseItem="false" CanvasName="CV_INV" XPosition="622" YPosition="12" Width="110" Height="22" Label="Mark paid" Enabled="true">
